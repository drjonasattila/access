      "autonomic_state": "freeze → exhaustion",
      "core_mechanism": "Internalisation, failed affective–autonomic integration",
      "triggers": [
        "trauma_role == victim",
        "autonomic_state == freeze OR collapse",
        "emotional_survival_axis_features == high",
        "exertional_intolerance == true"
      ],
      "symptoms": [
        "fibromyalgia",
        "chronic fatigue syndrome",
        "functional GI pain (IBS, dyspepsia)",
        "migraine with aura",
        "palpitations + chest pain (non-cardiac)",
        "diffuse visceral or whole-body pain"
      ],
      "interventions": {
        "do": [
          "Taiyin support first (nutrition, rhythm, Yin)",
          "Gentle Shaoyang ventilation (not breakthrough)",
          "Body-based boundary re-learning"
        ],
        "do_not": [
          "Strong stimulation or forced activation",
          "Early confrontation or psychodynamic excavation",
          "Excess explanation or cognitive overload"
        ]
      }
    },
    {
      "name": "savior_pattern",
      "label": "Savior Role — Structurally Maintained Load",
      "description": "Over-holding, responsibility fixation. Sustained sympathetic control.",
      "trauma_role": "savior",
      "germ_layer": "Ectoderm → Mesoderm",
      "meridian_axis": "Taiyang → Shaoyin",
      "autonomic_state": "sustained sympathetic control",
      "core_mechanism": "Over-holding, responsibility fixation",
      "triggers": [
        "trauma_role == savior",
        "autonomic_state == maintain OR control",
        "lateral_MSK_tension == high",
        "emotional_survival_axis_features == suppressed_outward"
      ],
      "symptoms": [
        "chronic neck-shoulder pain",
        "low back / SI joint pain",
        "tension-type headache",
        "stress-linked neuropathic pain",
        "insomnia-associated pain"
      ],
      "interventions": {
        "do": [
          "Gradual control release (not collapse)",
          "Shaoyin reinforcement (deep support)",
          "Structured non-doing / parasympathetic re-entry"
        ],
        "do_not": [
          "Add responsibility or endurance framing",
          "Continuous activation without rest",
          "Isolated muscle-only treatment"
        ]
      }
    },
    {
      "name": "perpetrator_pattern",
      "label": "Perpetrator Role — Externally Displaced Load",
      "description": "Externalisation. Delayed self-perception. Fight/discharge autonomic state.",
      "trauma_role": "perpetrator",
      "germ_layer": "Mesoderm → Endoderm",
      "meridian_axis": "Yangming / Shaoyin dominance",
      "autonomic_state": "fight / discharge",
      "core_mechanism": "Externalisation, delayed self-perception",
      "triggers": [
        "trauma_role == perpetrator",
        "autonomic_state == externalise OR discharge",
        "inflammatory_markers == elevated",
        "visceral_sensitivity == high"
      ],
      "symptoms": [
        "inflammatory pain states",
        "metabolic pain (NAFLD-related, diabetic)",
        "vascular / congestion pain (pelvic congestion)",
        "late-presenting visceral pain",
        "relational somatisation (symptoms in others)"
      ],
      "interventions": {
        "do": [
          "Body-anchored feedback and limits",
          "Endoderm survival pattern awareness",
          "Delayed psychological processing"
        ],
        "do_not": [
          "Moralising or early empathy forcing",
          "Victim–savior reenactment",
          "Pure insight-based therapy"
        ]
      }
    }
  ],
